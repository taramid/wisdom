{% extends 'base.html.twig' %}

{% block title %}{{ parent() }}{% endblock %}

{% block body %}
    {% if wisdoms is defined and wisdoms|length > 0 %}
        <div class="flex flex-col gap-y-4">
            {% for wisdom in wisdoms %}
                <twig:Wisdom :wisdom="wisdom"/>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-4xl">¯\_(ツ)_/¯</div>
    {% endif %}

    <a href="{{ path('app_wisdom_new') }}">Create new</a>
{% endblock %}
