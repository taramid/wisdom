{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | {{ wisdom.title }}{% endblock %}

{% block header_action %}
    {% include('partials/_new_wisdom.html.twig') %}
{% endblock %}

{% block body %}

    <twig:Wisdom :wisdom="wisdom" />

    {% if is_granted('ROLE_CREATOR') %}
        <div class="flex justify-between my-4 sm:my-6">

            <a href="{{ path('app_wisdom_edit', {'id': wisdom.id}) }}" class="flex justify-center btn">EDIT</a>

            {{ include('wisdom/_delete_form.html.twig') }}
        </div>
    {% endif %}

{% endblock %}
