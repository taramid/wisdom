{% extends 'base.html.twig' %}

{% block meta %}
    <meta name="turbo-cache-control" content="no-preview">
{% endblock %}

{% block title %}{{ parent() }} | {{ wisdom.title ?? '-' }}{% endblock %}

{% block header_action %}
    {% include('partials/_new_wisdom.html.twig') %}
{% endblock %}

{% block header_wisdom %}
    <a href="{{ path('app_wisdom_random') }}" data-turbo-frame="random_wisdom" class="font-bold text-xl text-indigo-600">wisdom</a>
{% endblock %}

{% block body %}

    {% if wisdom is defined and wisdom %}
        {% include 'wisdom/_random_frame.html.twig' %}
    {% else %}
        <twig:None />
    {% endif %}

{% endblock %}
