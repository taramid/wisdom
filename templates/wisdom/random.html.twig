{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | {{ wisdom.title ?? '-' }}{% endblock %}

{% block header_action %}
    {% include('partials/_new_wisdom.html.twig') %}
{% endblock %}

{% block body %}

    {% if wisdom is defined and wisdom %}
        <turbo-frame id="random_wisdom">
            <twig:Wisdom :wisdom="wisdom" />
        </turbo-frame>
    {% else %}
        <twig:None />
    {% endif %}

{% endblock %}
