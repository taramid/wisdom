{% extends 'base.html.twig' %}

{% block title %}{{ subject.title }}{% endblock %}

{% block header_action %}
    {% include 'partials/_new_wisdom.html.twig' with {'subject': subject.id} %}
{% endblock %}

{% block body %}

    <div class="flex flex-col gap-y-4 sm:gap-y-6">

        <twig:Subject :subject="subject" />

        {% if is_granted('ROLE_CREATOR') %}
            <div class="flex justify-between">

                <a href="{{ path('app_subject_edit', {'id': subject.id}) }}" class="flex justify-center btn">EDIT</a>

                {{ include('subject/_delete_form.html.twig') }}
            </div>
        {% endif %}

        <twig:WisdomList :wisdoms="wisdoms" />
    </div>

{% endblock %}
