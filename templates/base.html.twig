<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}wisdom{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="bg-slate-50 text-slate-900 antialiased font-sans min-h-screen flex flex-col selection:bg-indigo-500 selection:text-white overflow-x-clip">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 overflow-x-clip">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-11 sm:h-14 flex items-center justify-between">
            <a href="{{ path('app_subject_index') }}" class="font-bold text-xl text-indigo-600">subjects</a>

            {% block header_action %}{% endblock %}

            <a href="{{ path('app_wisdom_random') }}" class="font-bold text-xl text-indigo-600">wisdom</a>
        </div>
    </header>

    <main class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 overflow-x-clip">
        {% block body %}{% endblock %}
    </main>

    <footer class="relative bg-white border-t border-slate-200 py-1 sm:py-2 text-center text-sm text-slate-500 overflow-x-clip">
        <div class="absolute left-4 sm:left-6 top-1/2 -translate-y-1/2 text-xs font-mono text-slate-300 pointer-events-none select-none z-0">
            {% if git_hash|length > 22 %}
                {{ git_hash|slice(0, 7) }}<span class="border-1">{{ git_hash|slice(7, 1) }}</span>
            {% endif %}
        </div>
        <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
            &copy; {{ "now"|date("Y") }} нотатки
        </div>
    </footer>

    </body>
</html>
