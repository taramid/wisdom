{% extends 'base.html.twig' %}

{% block body %}
    <div class="w-64 sm:w-80 mx-auto mt-16">
        <h2>Вхід у записник</h2>

        {% if error %}
            <div style="color: red; margin-bottom: 10px;">
                Невірний код!
                <br>
                {{ error.message }}
            </div>
        {% endif %}

        <form method="post">
            <label for="password">Пароль:</label>
            <input type="password" id="password" name="password" autofocus required style="width: 100%; padding: 8px; margin: 10px 0;">

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" style="width: 100%; padding: 10px;">Увійти</button>
        </form>
    </div>
{% endblock %}
